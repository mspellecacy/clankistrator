# Copy to .env (or .env.local, which takes precedence) and fill in the key for
# the provider you use. Only the provider of the chosen model needs a key.
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
GEMINI_API_KEY=your_gemini_key_here

# openrouter: models (one key, models from many vendors).
OPENROUTER_API_KEY=your_openrouter_key_here
# Refuse OpenRouter models that cost money (names not ending in :free).
# OPENROUTER_FREE_ONLY=true

# Only needed for ollama: models when the server is not on the default address.
OLLAMA_BASE_URL=http://localhost:11434

# compatible: models, for any server that speaks the OpenAI chat-completions
# protocol (LM Studio, vLLM, llama.cpp, a gateway). The key is optional.
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:1234/v1
# OPENAI_COMPATIBLE_API_KEY=

# Defaults for --model and --output. A provider prefix is allowed,
# e.g. DEFAULT_MODEL=ollama:llama3.2
DEFAULT_MODEL=gpt-6.1-sol
WORKING_DIRECTORY=./implementation

# trace, debug, info, warn or error. RUST_LOG overrides it.
LOG_LEVEL=info
